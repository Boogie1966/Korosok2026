<metadata><name>Körös vízitúra 2026.07.28-08.02.</name></metadata>
<wpt lat="46.70064" lon="21.26868"><name>1. Szanazug kemping - START</name><desc>TÁBORHELY 07.28. Kettős-Körös 37,3 fkm. WC, zuhany, büfé, áram, tűzrakó, homokos strand.</desc></wpt>
<wpt lat="46.75784" lon="21.16265"><name>Békés-Dánfok - megálló</name><desc>07.29, 10,3 km-nél. WC, zuhany, büfé, strand. Kb. K 27 fkm.</desc></wpt>
<wpt lat="46.77121" lon="21.14603"><name>Békési közúti híd</name><desc>K 25 fkm. Utána 2 km-rel kezdődnek a Samu-kanyarok.</desc></wpt>
<wpt lat="46.85290" lon="21.08639"><name>Mezőberényi híd - büfé</name><desc>07.29, 24,3 km-nél. Árnyékos büfé, Petőfi-emlékoszlop. K 13 fkm.</desc></wpt>
<wpt lat="46.88451" lon="21.03158"><name>2. Köröstarcsai kishajókikötő</name><desc>TÁBORHELY 07.29. K 7,0 fkm. WC, zuhany, büfé, ivóvíz, áram, tűzrakó.</desc></wpt>
<wpt lat="46.92012" lon="20.97718"><name>Kettős + Sebes összefolyás</name><desc>H 91,3 fkm. Stég, fürdőhely. Innen Hármas-Körös.</desc></wpt>
<wpt lat="46.92217" lon="20.96219"><name>Félhalmi Horgásztanya - büfé</name><desc>07.30. Árnyékos büfé, jégkrém, hivatalos kikötő. H ~90 fkm.</desc></wpt>
<wpt lat="46.94574" lon="20.82178"><name>3. Gyomaendrőd - Csicsergő</name><desc>TÁBORHELY 07.30. H 77,0 fkm bal part. Úszó stég, WC, zuhany, büfé, WiFi, parkoló.</desc></wpt>
<wpt lat="46.93977" lon="20.63530"><name>Kisörvetői gátőrház - megálló</name><desc>07.31, 15,8 km-nél. Stég, tölgyes, WC, zuhany, áram. H 61,2 fkm.</desc></wpt>
<wpt lat="46.91330" lon="20.56013"><name>Halászlak - Harcsa büfé</name><desc>07.31, 23,2 km-nél. Büfé, WC, 1 zuhany, vasúti megálló 100 m. H 53,8 fkm. TARTALÉK kiszálló.</desc></wpt>
<wpt lat="46.89953" lon="20.53593"><name>ÁTEMELÉS - kiszállás az élő vízről</name><desc>07.31, H 50,5 fkm bal part. Innen utánfutóval 3,5 km a Holt-Körösig. Lejáró egyeztetendő!</desc></wpt>
<wpt lat="46.89239" lon="20.50475"><name>Békésszentandrási duzzasztó - NEM útvonal</name><desc>H ~48 fkm. Ez duzzasztja a teljes felettes szakaszt, ezért nincs sodrás.</desc></wpt>
<wpt lat="46.87200" lon="20.55800"><name>4. Szarvasi Ifjúsági Tábor - VÉGPONT</name><desc>TÁBORHELY 07.31 + 08.01. Erzsébet-liget, Holt-Körös part. 3 stég, WC, zuhany, sátorozás. +36 20 480 1761</desc></wpt>
<wpt lat="46.87300" lon="20.52200"><name>Szarvasi Arborétum (Pepi-kert)</name><desc>08.01 holtági nap fordulópontja, kb. 8-10 km oda-vissza.</desc></wpt>
